# Copy to .env. Use the exact base URL and model ID from your AMD account.
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
# Optional prices in USD per one million tokens. Leave blank when unknown/free.
AMD_INPUT_PRICE_PER_MILLION=
AMD_OUTPUT_PRICE_PER_MILLION=
PORT=4173
# Deployment only: bind the container and allow the exact public app origin.
HOST=127.0.0.1
APP_ORIGIN=
